# /etc/systemd/system/cinema@.service  (App VM)
# One template, three instances: cinema@user-service, cinema@product-service, cinema@order-service
[Unit]
Description=Cinema %i (FastAPI)
After=network.target

[Service]
User=appuser
WorkingDirectory=/opt/apps/%i
EnvironmentFile=/etc/cinema/%i.env
ExecStart=/opt/apps/%i/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT} --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
